# LLM providers (two different providers are required; the router uses both)
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Embedding (local, fastembed ONNX; no API key)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store (Chroma, embedded; index is baked into the image)
CHROMA_PERSIST_DIR=./chroma_index
CHROMA_COLLECTION=techdocs
RETRIEVAL_K=5

# Real-time knowledge (Tavily Remote MCP; key goes in the URL query string)
TAVILY_API_KEY=tvly-...

# Conversation state: sqlite for local dev, firestore on Cloud Run
STATE_BACKEND=sqlite
FIRESTORE_PROJECT_ID=your-project-id

# Cloud Run deployment
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=multi-agent-rag
